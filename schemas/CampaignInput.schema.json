{
  "$defs": {
    "CampaignContext": {
      "additionalProperties": false,
      "properties": {
        "audience": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Audience"
        },
        "jurisdiction": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Jurisdiction"
        },
        "language": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Language"
        },
        "platform": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Platform"
        },
        "product_category": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Product Category"
        }
      },
      "title": "CampaignContext",
      "type": "object"
    },
    "CreativeInput": {
      "additionalProperties": false,
      "properties": {
        "ad_copy": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Ad Copy",
          "type": "string"
        },
        "image_url": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Image Url",
          "type": "string"
        }
      },
      "required": [
        "image_url",
        "ad_copy"
      ],
      "title": "CreativeInput",
      "type": "object"
    },
    "SupportingDocument": {
      "additionalProperties": false,
      "properties": {
        "document_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Document Id",
          "type": "string"
        },
        "name": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "source_type": {
          "title": "Source Type",
          "type": "string"
        },
        "url": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "document_id",
        "name",
        "url",
        "source_type"
      ],
      "title": "SupportingDocument",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "campaign_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Campaign Id",
      "type": "string"
    },
    "context": {
      "$ref": "#/$defs/CampaignContext"
    },
    "creative": {
      "$ref": "#/$defs/CreativeInput"
    },
    "creative_version": {
      "minimum": 1,
      "title": "Creative Version",
      "type": "integer"
    },
    "evidence_documents": {
      "items": {
        "$ref": "#/$defs/SupportingDocument"
      },
      "maxItems": 3,
      "title": "Evidence Documents",
      "type": "array"
    },
    "landing_page_url": {
      "maxLength": 2048,
      "minLength": 1,
      "title": "Landing Page Url",
      "type": "string"
    },
    "product_context": {
      "additionalProperties": true,
      "title": "Product Context",
      "type": "object"
    },
    "repair_mode": {
      "default": "audit_only",
      "title": "Repair Mode",
      "type": "string"
    },
    "request_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Request Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "request_id",
    "campaign_id",
    "creative_version",
    "creative",
    "landing_page_url",
    "context"
  ],
  "title": "CampaignInput",
  "type": "object"
}
