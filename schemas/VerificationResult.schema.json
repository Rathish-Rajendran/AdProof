{
  "$defs": {
    "Claim": {
      "additionalProperties": false,
      "properties": {
        "claim": {
          "title": "Claim",
          "type": "string"
        },
        "claim_type": {
          "$ref": "#/$defs/ClaimType"
        },
        "conditions": {
          "additionalProperties": true,
          "title": "Conditions",
          "type": "object"
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "derivation": {
          "additionalProperties": true,
          "title": "Derivation",
          "type": "object"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "evidence_quality": {
          "$ref": "#/$defs/EvidenceQuality",
          "default": "NONE"
        },
        "explanation": {
          "title": "Explanation",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "landing_page_consistency": {
          "$ref": "#/$defs/LandingPageConsistency",
          "default": "NOT_ASSESSED"
        },
        "location": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Location"
        },
        "observation_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observation Id"
        },
        "original_wording": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Original Wording"
        },
        "source": {
          "$ref": "#/$defs/ClaimSource"
        },
        "status": {
          "$ref": "#/$defs/ClaimStatus"
        },
        "uncertainty": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Uncertainty"
        }
      },
      "required": [
        "id",
        "claim",
        "source",
        "claim_type",
        "status",
        "explanation"
      ],
      "title": "Claim",
      "type": "object"
    },
    "ClaimSource": {
      "enum": [
        "ad_text",
        "image"
      ],
      "title": "ClaimSource",
      "type": "string"
    },
    "ClaimStatus": {
      "enum": [
        "SUPPORTED",
        "CONTRADICTED",
        "INSUFFICIENT_EVIDENCE"
      ],
      "title": "ClaimStatus",
      "type": "string"
    },
    "ClaimType": {
      "enum": [
        "price",
        "discount",
        "quantitative_specification",
        "performance",
        "health",
        "comparison",
        "endorsement",
        "guarantee",
        "environmental",
        "urgency_scarcity",
        "other_objective"
      ],
      "title": "ClaimType",
      "type": "string"
    },
    "Coverage": {
      "additionalProperties": false,
      "properties": {
        "ad_text": {
          "$ref": "#/$defs/CoverageItem"
        },
        "image": {
          "$ref": "#/$defs/CoverageItem"
        },
        "landing_page": {
          "$ref": "#/$defs/CoverageItem"
        },
        "platform_policy": {
          "$ref": "#/$defs/CoverageItem"
        },
        "supporting_documents": {
          "$ref": "#/$defs/CoverageItem"
        }
      },
      "required": [
        "ad_text",
        "landing_page",
        "supporting_documents",
        "image",
        "platform_policy"
      ],
      "title": "Coverage",
      "type": "object"
    },
    "CoverageItem": {
      "additionalProperties": false,
      "properties": {
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "status": {
          "$ref": "#/$defs/CoverageStatus"
        }
      },
      "required": [
        "status"
      ],
      "title": "CoverageItem",
      "type": "object"
    },
    "CoverageStatus": {
      "enum": [
        "CHECKED",
        "PARTIAL",
        "NOT_CHECKED",
        "FAILED",
        "NOT_APPLICABLE"
      ],
      "title": "CoverageStatus",
      "type": "string"
    },
    "Decision": {
      "enum": [
        "PASS",
        "FIX_REQUIRED",
        "BLOCK",
        "HUMAN_REVIEW"
      ],
      "title": "Decision",
      "type": "string"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "conditions": {
          "additionalProperties": true,
          "title": "Conditions",
          "type": "object"
        },
        "content_sha256": {
          "title": "Content Sha256",
          "type": "string"
        },
        "document_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Document Id"
        },
        "excerpt": {
          "title": "Excerpt",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "locator": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Locator"
        },
        "retrieved_at": {
          "format": "date-time",
          "title": "Retrieved At",
          "type": "string"
        },
        "snapshot_id": {
          "title": "Snapshot Id",
          "type": "string"
        },
        "source_type": {
          "title": "Source Type",
          "type": "string"
        },
        "source_url": {
          "title": "Source Url",
          "type": "string"
        }
      },
      "required": [
        "id",
        "source_url",
        "excerpt",
        "source_type",
        "retrieved_at",
        "snapshot_id",
        "content_sha256"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "EvidenceQuality": {
      "enum": [
        "DIRECT",
        "QUALIFIED",
        "WEAK",
        "NONE"
      ],
      "title": "EvidenceQuality",
      "type": "string"
    },
    "Issue": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "$ref": "#/$defs/IssueAction"
        },
        "category": {
          "$ref": "#/$defs/IssueCategory"
        },
        "claim_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Claim Id"
        },
        "explanation": {
          "title": "Explanation",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "policy_reference": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Policy Reference"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "subtype": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Subtype"
        },
        "suggested_fix": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Suggested Fix"
        }
      },
      "required": [
        "id",
        "category",
        "severity",
        "explanation",
        "action"
      ],
      "title": "Issue",
      "type": "object"
    },
    "IssueAction": {
      "enum": [
        "FIX",
        "REVIEW",
        "BLOCK"
      ],
      "title": "IssueAction",
      "type": "string"
    },
    "IssueCategory": {
      "enum": [
        "UNSUPPORTED_OBJECTIVE_CLAIM",
        "PRICE_DISCOUNT_MISMATCH",
        "UNVERIFIED_ENDORSEMENT",
        "MISSING_REQUIRED_DISCLOSURE",
        "AD_LANDING_PAGE_CONTRADICTION"
      ],
      "title": "IssueCategory",
      "type": "string"
    },
    "LandingPageConsistency": {
      "enum": [
        "MATCH",
        "MISMATCH",
        "NOT_FOUND",
        "NOT_ASSESSED"
      ],
      "title": "LandingPageConsistency",
      "type": "string"
    },
    "Phase": {
      "enum": [
        "ORIGINAL",
        "REPAIRED"
      ],
      "title": "Phase",
      "type": "string"
    },
    "PolicyCheck": {
      "additionalProperties": false,
      "properties": {
        "applicable": {
          "title": "Applicable",
          "type": "boolean"
        },
        "checked": {
          "title": "Checked",
          "type": "boolean"
        },
        "enforcement": {
          "$ref": "#/$defs/PolicyEnforcement"
        },
        "finding": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Finding"
        },
        "predicate_established": {
          "default": false,
          "title": "Predicate Established",
          "type": "boolean"
        },
        "review_status": {
          "$ref": "#/$defs/PolicyReviewStatus"
        },
        "rule_id": {
          "title": "Rule Id",
          "type": "string"
        }
      },
      "required": [
        "rule_id",
        "applicable",
        "review_status",
        "enforcement",
        "checked"
      ],
      "title": "PolicyCheck",
      "type": "object"
    },
    "PolicyEnforcement": {
      "enum": [
        "FIX",
        "REVIEW",
        "BLOCK"
      ],
      "title": "PolicyEnforcement",
      "type": "string"
    },
    "PolicyReviewStatus": {
      "enum": [
        "DRAFT",
        "ACTIVE",
        "DISABLED"
      ],
      "title": "PolicyReviewStatus",
      "type": "string"
    },
    "Severity": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "title": "Severity",
      "type": "string"
    },
    "TypedError": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "$ref": "#/$defs/TypedErrorCode"
        },
        "details": {
          "additionalProperties": true,
          "title": "Details",
          "type": "object"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "default": false,
          "title": "Retryable",
          "type": "boolean"
        },
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "TypedError",
      "type": "object"
    },
    "TypedErrorCode": {
      "enum": [
        "MODEL_UNAVAILABLE",
        "MODEL_AUTH",
        "MODEL_MALFORMED_OUTPUT",
        "BUDGET_EXHAUSTED",
        "TIMEOUT",
        "TASK_TIMEOUT",
        "PAYLOAD_TOO_LARGE",
        "WORKFLOW_INTERRUPTED",
        "SOURCE_UNAVAILABLE",
        "UNSAFE_SOURCE",
        "SOURCE_TOO_LARGE",
        "INVALID_IMAGE",
        "IMAGE_TOO_LARGE",
        "INVALID_EVIDENCE",
        "UNSUPPORTED_CONTEXT",
        "INTERNAL"
      ],
      "title": "TypedErrorCode",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "audit_complete": {
      "title": "Audit Complete",
      "type": "boolean"
    },
    "audit_id": {
      "title": "Audit Id",
      "type": "string"
    },
    "campaign_id": {
      "title": "Campaign Id",
      "type": "string"
    },
    "candidate_id": {
      "title": "Candidate Id",
      "type": "string"
    },
    "claims": {
      "items": {
        "$ref": "#/$defs/Claim"
      },
      "title": "Claims",
      "type": "array"
    },
    "coverage": {
      "$ref": "#/$defs/Coverage"
    },
    "creative_version": {
      "title": "Creative Version",
      "type": "integer"
    },
    "decision": {
      "$ref": "#/$defs/Decision"
    },
    "errors": {
      "items": {
        "$ref": "#/$defs/TypedError"
      },
      "title": "Errors",
      "type": "array"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "title": "Evidence",
      "type": "array"
    },
    "evidence_scope": {
      "title": "Evidence Scope",
      "type": "string"
    },
    "ignored_statements": {
      "items": {
        "additionalProperties": {
          "type": "string"
        },
        "type": "object"
      },
      "title": "Ignored Statements",
      "type": "array"
    },
    "issues": {
      "items": {
        "$ref": "#/$defs/Issue"
      },
      "title": "Issues",
      "type": "array"
    },
    "metrics": {
      "additionalProperties": true,
      "title": "Metrics",
      "type": "object"
    },
    "phase": {
      "$ref": "#/$defs/Phase"
    },
    "policy_catalog_version": {
      "title": "Policy Catalog Version",
      "type": "string"
    },
    "policy_checks": {
      "items": {
        "$ref": "#/$defs/PolicyCheck"
      },
      "title": "Policy Checks",
      "type": "array"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "scope_notes": {
      "items": {
        "type": "string"
      },
      "title": "Scope Notes",
      "type": "array"
    }
  },
  "required": [
    "audit_id",
    "campaign_id",
    "candidate_id",
    "creative_version",
    "phase",
    "decision",
    "audit_complete",
    "evidence_scope",
    "coverage",
    "policy_catalog_version"
  ],
  "title": "VerificationResult",
  "type": "object"
}
