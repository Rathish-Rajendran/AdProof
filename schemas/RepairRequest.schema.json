{
  "$defs": {
    "Claim": {
      "additionalProperties": false,
      "properties": {
        "claim": {
          "title": "Claim",
          "type": "string"
        },
        "claim_type": {
          "$ref": "#/$defs/ClaimType"
        },
        "conditions": {
          "additionalProperties": true,
          "title": "Conditions",
          "type": "object"
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "derivation": {
          "additionalProperties": true,
          "title": "Derivation",
          "type": "object"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "evidence_quality": {
          "$ref": "#/$defs/EvidenceQuality",
          "default": "NONE"
        },
        "explanation": {
          "title": "Explanation",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "landing_page_consistency": {
          "$ref": "#/$defs/LandingPageConsistency",
          "default": "NOT_ASSESSED"
        },
        "location": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Location"
        },
        "observation_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observation Id"
        },
        "original_wording": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Original Wording"
        },
        "source": {
          "$ref": "#/$defs/ClaimSource"
        },
        "status": {
          "$ref": "#/$defs/ClaimStatus"
        },
        "uncertainty": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Uncertainty"
        }
      },
      "required": [
        "id",
        "claim",
        "source",
        "claim_type",
        "status",
        "explanation"
      ],
      "title": "Claim",
      "type": "object"
    },
    "ClaimSource": {
      "enum": [
        "ad_text",
        "image"
      ],
      "title": "ClaimSource",
      "type": "string"
    },
    "ClaimStatus": {
      "enum": [
        "SUPPORTED",
        "CONTRADICTED",
        "INSUFFICIENT_EVIDENCE"
      ],
      "title": "ClaimStatus",
      "type": "string"
    },
    "ClaimType": {
      "enum": [
        "price",
        "discount",
        "quantitative_specification",
        "performance",
        "health",
        "comparison",
        "endorsement",
        "guarantee",
        "environmental",
        "urgency_scarcity",
        "other_objective"
      ],
      "title": "ClaimType",
      "type": "string"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "conditions": {
          "additionalProperties": true,
          "title": "Conditions",
          "type": "object"
        },
        "content_sha256": {
          "title": "Content Sha256",
          "type": "string"
        },
        "document_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Document Id"
        },
        "excerpt": {
          "title": "Excerpt",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "locator": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Locator"
        },
        "retrieved_at": {
          "format": "date-time",
          "title": "Retrieved At",
          "type": "string"
        },
        "snapshot_id": {
          "title": "Snapshot Id",
          "type": "string"
        },
        "source_type": {
          "title": "Source Type",
          "type": "string"
        },
        "source_url": {
          "title": "Source Url",
          "type": "string"
        }
      },
      "required": [
        "id",
        "source_url",
        "excerpt",
        "source_type",
        "retrieved_at",
        "snapshot_id",
        "content_sha256"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "EvidenceQuality": {
      "enum": [
        "DIRECT",
        "QUALIFIED",
        "WEAK",
        "NONE"
      ],
      "title": "EvidenceQuality",
      "type": "string"
    },
    "Issue": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "$ref": "#/$defs/IssueAction"
        },
        "category": {
          "$ref": "#/$defs/IssueCategory"
        },
        "claim_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Claim Id"
        },
        "explanation": {
          "title": "Explanation",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "policy_reference": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Policy Reference"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "subtype": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Subtype"
        },
        "suggested_fix": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Suggested Fix"
        }
      },
      "required": [
        "id",
        "category",
        "severity",
        "explanation",
        "action"
      ],
      "title": "Issue",
      "type": "object"
    },
    "IssueAction": {
      "enum": [
        "FIX",
        "REVIEW",
        "BLOCK"
      ],
      "title": "IssueAction",
      "type": "string"
    },
    "IssueCategory": {
      "enum": [
        "UNSUPPORTED_OBJECTIVE_CLAIM",
        "PRICE_DISCOUNT_MISMATCH",
        "UNVERIFIED_ENDORSEMENT",
        "MISSING_REQUIRED_DISCLOSURE",
        "AD_LANDING_PAGE_CONTRADICTION"
      ],
      "title": "IssueCategory",
      "type": "string"
    },
    "LandingPageConsistency": {
      "enum": [
        "MATCH",
        "MISMATCH",
        "NOT_FOUND",
        "NOT_ASSESSED"
      ],
      "title": "LandingPageConsistency",
      "type": "string"
    },
    "Severity": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "title": "Severity",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "ad_copy": {
      "maxLength": 4096,
      "title": "Ad Copy",
      "type": "string"
    },
    "audit_id": {
      "title": "Audit Id",
      "type": "string"
    },
    "campaign_id": {
      "title": "Campaign Id",
      "type": "string"
    },
    "candidate_id": {
      "title": "Candidate Id",
      "type": "string"
    },
    "claims": {
      "items": {
        "$ref": "#/$defs/Claim"
      },
      "title": "Claims",
      "type": "array"
    },
    "deadline": {
      "format": "date-time",
      "title": "Deadline",
      "type": "string"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "title": "Evidence",
      "type": "array"
    },
    "issues": {
      "items": {
        "$ref": "#/$defs/Issue"
      },
      "title": "Issues",
      "type": "array"
    },
    "original_candidate_id": {
      "title": "Original Candidate Id",
      "type": "string"
    },
    "request_id": {
      "title": "Request Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "audit_id",
    "request_id",
    "campaign_id",
    "original_candidate_id",
    "candidate_id",
    "ad_copy",
    "deadline"
  ],
  "title": "RepairRequest",
  "type": "object"
}
