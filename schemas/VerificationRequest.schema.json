{
  "$defs": {
    "CampaignContext": {
      "additionalProperties": false,
      "properties": {
        "audience": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Audience"
        },
        "jurisdiction": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Jurisdiction"
        },
        "language": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Language"
        },
        "platform": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Platform"
        },
        "product_category": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Product Category"
        }
      },
      "title": "CampaignContext",
      "type": "object"
    },
    "ImageRegion": {
      "additionalProperties": false,
      "properties": {
        "height": {
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Height",
          "type": "number"
        },
        "width": {
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Width",
          "type": "number"
        },
        "x": {
          "maximum": 1,
          "minimum": 0,
          "title": "X",
          "type": "number"
        },
        "y": {
          "maximum": 1,
          "minimum": 0,
          "title": "Y",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "title": "ImageRegion",
      "type": "object"
    },
    "InspectionStatus": {
      "enum": [
        "COMPLETE",
        "PARTIAL",
        "FAILED",
        "NOT_PROVIDED"
      ],
      "title": "InspectionStatus",
      "type": "string"
    },
    "Observation": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "$ref": "#/$defs/ObservationKind"
        },
        "observation_id": {
          "title": "Observation Id",
          "type": "string"
        },
        "region": {
          "anyOf": [
            {
              "$ref": "#/$defs/ImageRegion"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "uncertainty_note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Uncertainty Note"
        }
      },
      "required": [
        "observation_id",
        "kind",
        "text"
      ],
      "title": "Observation",
      "type": "object"
    },
    "ObservationKind": {
      "enum": [
        "visible_text",
        "visual_observation",
        "inferred_claim"
      ],
      "title": "ObservationKind",
      "type": "string"
    },
    "Phase": {
      "enum": [
        "ORIGINAL",
        "REPAIRED"
      ],
      "title": "Phase",
      "type": "string"
    },
    "SupportingDocument": {
      "additionalProperties": false,
      "properties": {
        "document_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Document Id",
          "type": "string"
        },
        "name": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "source_type": {
          "title": "Source Type",
          "type": "string"
        },
        "url": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "document_id",
        "name",
        "url",
        "source_type"
      ],
      "title": "SupportingDocument",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "ad_copy": {
      "maxLength": 4096,
      "title": "Ad Copy",
      "type": "string"
    },
    "audit_id": {
      "title": "Audit Id",
      "type": "string"
    },
    "campaign_id": {
      "title": "Campaign Id",
      "type": "string"
    },
    "candidate_id": {
      "title": "Candidate Id",
      "type": "string"
    },
    "context": {
      "$ref": "#/$defs/CampaignContext"
    },
    "creative_version": {
      "minimum": 1,
      "title": "Creative Version",
      "type": "integer"
    },
    "deadline": {
      "format": "date-time",
      "title": "Deadline",
      "type": "string"
    },
    "evidence_documents": {
      "items": {
        "$ref": "#/$defs/SupportingDocument"
      },
      "maxItems": 3,
      "title": "Evidence Documents",
      "type": "array"
    },
    "image_inspection_status": {
      "$ref": "#/$defs/InspectionStatus"
    },
    "image_observations": {
      "items": {
        "$ref": "#/$defs/Observation"
      },
      "title": "Image Observations",
      "type": "array"
    },
    "landing_page_url": {
      "title": "Landing Page Url",
      "type": "string"
    },
    "phase": {
      "$ref": "#/$defs/Phase"
    },
    "product_context": {
      "additionalProperties": true,
      "title": "Product Context",
      "type": "object"
    },
    "request_id": {
      "title": "Request Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "audit_id",
    "request_id",
    "campaign_id",
    "candidate_id",
    "creative_version",
    "phase",
    "ad_copy",
    "landing_page_url",
    "context",
    "image_inspection_status",
    "deadline"
  ],
  "title": "VerificationRequest",
  "type": "object"
}
